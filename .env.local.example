# Copy this file to .env.local and fill in real values for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables instead.

# --- Database ---
# Auto-populated if you use Vercel Postgres and run `vercel env pull .env.local`.
POSTGRES_URL=

# --- Vision API (Google Gemini) ---
# Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Email (Resend) ---
# Needed for password reset emails and the optional recurring/budget
# notification emails. Free API key: https://resend.com/api-keys
# EMAIL_FROM is optional and falls back to Resend's shared onboarding
# address, which only works for testing — use a verified domain in
# production.
RESEND_API_KEY=
EMAIL_FROM=

# --- Auth ---
# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Sign in with GitHub (optional) ---
# Create an OAuth App at https://github.com/settings/developers with its
# "Authorization callback URL" set to:
#   http://localhost:3000/api/auth/github/callback   (local dev)
#   https://your-domain/api/auth/github/callback     (production)
# Leave both unset to hide the "Continue with GitHub" button — username/
# password sign-in always works regardless.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# On Vercel specifically, set APP_URL too if you use GitHub sign-in — every
# deployment also gets its own unique *.vercel.app alias in addition to your
# real domain, and if you (or a visitor) ever load the app through one of
# those instead of your real domain, the callback URL Tally sends won't
# match the one registered above and GitHub will reject it with "The
# redirect_uri is not associated with this application." Setting this pins
# it to always match, regardless of which URL was actually visited.
# APP_URL=https://your-domain

# --- Admin bootstrap (only needed once, for the very first deploy) ---
# On the very first request after deploy, if no accounts exist yet and both
# of these are set, an admin account is created with them and any existing
# data (from before multi-user accounts existed) is assigned to it. Safe to
# leave unset on a brand-new install where everyone just signs up normally
# at /register. Remove these two lines after confirming the admin account
# was created successfully.
ADMIN_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
